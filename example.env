# LiveTracker Collector settings - copy to collector.env, fill in, then either:
#   Linux:   docker run -d --name livetracker-collector --restart unless-stopped --network host \
#              --env-file collector.env -v livetracker-collector:/data \
#              ghcr.io/livetrackerjm/livetracker-collector:latest
#   Windows: py -m collector            (from the collector folder - see README)

# From LiveTracker > IT Asset Tracker > Connectors > Network collector
LT_URL=https://livetracker.uk
LT_TOKEN=ltc_0_paste-the-key-shown-once-in-livetracker

# What to look at: subnets, ranges, single IPs or hostnames, comma-separated (max 4096 hosts),
# or "auto" for the network this machine is on
LT_TARGETS=auto
# LT_TARGETS=192.168.1.0/24,192.168.10.2-192.168.10.40

# Network scan: finds everything on the network - routers, Wi-Fi, PCs, phones, printers, TVs,
# smart devices - without any setup on the devices. On by default.
# LT_SCAN=on

# Optional: SNMP for health detail from switches, servers, NAS, printers and UPSs.
# SNMPv3 (recommended) - a read-only user configured on each device
# SNMP_VERSION=3
# SNMP_USER=livetracker
# SNMP_AUTH_PROTO=SHA
# SNMP_AUTH_PASS=at-least-8-characters
# SNMP_PRIV_PROTO=AES
# SNMP_PRIV_PASS=at-least-8-characters

# ...or SNMPv2c (read-only community)
# SNMP_VERSION=2c
# SNMP_COMMUNITY=your-read-only-community

# Optional tuning
# LT_INTERVAL=300            # seconds between cycles (min 60)
# LT_WORKERS=32              # parallel SNMP queries (the scan uses twice this)
# LT_SCAN_TIMEOUT=0.8        # seconds per TCP knock in the network scan
# SNMP_TIMEOUT=2             # seconds, known devices
# SNMP_DISCOVERY_TIMEOUT=1   # seconds, sweeping for new devices
# SNMP_RETRIES=1
