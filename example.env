# LiveTracker Collector settings - copy to collector.env, fill in, then:
#   docker run -d --name livetracker-collector --restart unless-stopped \
#     --env-file collector.env -v livetracker-collector:/data \
#     ghcr.io/livetrackerjm/livetracker-collector:latest

# From LiveTracker > IT Asset Tracker > Connectors > Network collector
LT_URL=https://livetracker.uk
LT_TOKEN=ltc_0_paste-the-key-shown-once-in-livetracker

# What to poll: subnets, ranges, single IPs or hostnames, comma-separated (max 4096 hosts)
LT_TARGETS=192.168.1.0/24,192.168.10.2-192.168.10.40

# SNMPv3 (recommended) - a read-only user configured on each device
SNMP_VERSION=3
SNMP_USER=livetracker
SNMP_AUTH_PROTO=SHA
SNMP_AUTH_PASS=at-least-8-characters
SNMP_PRIV_PROTO=AES
SNMP_PRIV_PASS=at-least-8-characters

# ...or SNMPv2c (read-only community)
# SNMP_VERSION=2c
# SNMP_COMMUNITY=your-read-only-community

# Optional tuning
# LT_INTERVAL=300            # seconds between polls (min 60)
# LT_WORKERS=32              # parallel SNMP queries
# SNMP_TIMEOUT=2             # seconds, known devices
# SNMP_DISCOVERY_TIMEOUT=1   # seconds, sweeping for new devices
# SNMP_RETRIES=1
